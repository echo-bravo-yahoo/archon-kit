{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f \"${ARCHON_HOME:-$HOME/.archon}/scripts/lane-hook.mjs\" ] && exec node \"${ARCHON_HOME:-$HOME/.archon}/scripts/lane-hook.mjs\"; exit 0'"
          }
        ]
      }
    ]
  }
}
